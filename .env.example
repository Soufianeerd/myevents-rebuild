# Local development only. Copy to .env.local; never commit real credentials.
APP_MODE=local
APP_URL=http://localhost:3000
LOCAL_DATA_DIR=.data

# Neon Preview (restricted application role; never use the owner connection):
# APP_MODE=connected
# CONNECTED_PROVIDER=neon
# APP_URL=https://YOUR-STABLE-PREVIEW-HOST.vercel.app
# DATABASE_URL=postgresql://myevents_app:SECRET@YOUR-NEON-POOLER.neon.tech/myevents?sslmode=verify-full
# NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.c-5.eu-central-1.aws.neon.tech/myevents/auth
# NEON_AUTH_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Previous Supabase adapter, explicit opt-in only:
# CONNECTED_PROVIDER=supabase
# APP_MODE=connected
# APP_URL=https://YOUR-STABLE-PREVIEW-HOST.vercel.app
# SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR-STAGING-PUBLISHABLE-KEY
# No service_role key is required by this application.
# Configure Supabase Auth email templates and SMTP per docs/DEPLOYMENT.md.
